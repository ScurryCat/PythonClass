# ============================================================
#  wy_site 项目 .gitignore
#  说明：下面被忽略的东西都不会被提交到 Git。
#        规则按「为什么忽略」分组，方便你以后自己改。
# ============================================================


# ------------------------------------------------------------
# 1. Python 运行产生的缓存
#    __pycache__ 是 .py 编译后的 .pyc 字节码，每台机器自己生成就行。
#    注意：不要把 migrations/__pycache__ 和 migrations/0001_initial.py 搞混，
#          迁移文件（.py）是必须提交的，只有 __pycache__ 目录忽略。
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so


# ------------------------------------------------------------
# 2. 虚拟环境
#    虚拟环境体积大、和机器绑定，不进 Git。
#    用 pip freeze > requirements.txt 记录依赖，别人照着装。
# ------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version


# ------------------------------------------------------------
# 3. Django 专属
#    你的项目现在用 MySQL，所以 db.sqlite3 是早期试手留下的空文件，
#    留着可能误导人（以为项目用 SQLite），直接忽略。
#    真要换回 SQLite 也照样忽略 —— 数据库文件不该进版本库。
# ------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# 用户上传的媒体文件（以后做了上传功能再加）
media/
MEDIA_ROOT/

# collectstatic 收集出来的静态文件目录（部署时才用）
staticfiles/
STATIC_ROOT/

# 本地开发日志
*.log
logs/


# ------------------------------------------------------------
# 4. 数据库备份 —— ★ 重要，别提交 ★
#    course_backup.sql 里包含完整数据，包括 auth_user 表的
#    密码哈希（后台账号 wy）。提交到 Git 就等于把账号泄露出去。
#    正确做法：备份只在本地/ U 盘保存，上课前手动导入。
# ------------------------------------------------------------
course_backup.sql
course_backup.sql.bak
BACKUP_上课备份/
*.sql
*.dump

# 例外：这是项目的测试数据脚本，不含密码，要提交
!wy_site/sql/seed_demo_data.sql


# ------------------------------------------------------------
# 5. 敏感配置 —— ★ 重要 ★
#    settings.py 里的数据库配置改成了从环境变量读，
#    真实密码放在 wy_site/wy_site/local_settings.py，这个文件不进 Git。
#    仓库里只保留 local_settings.example.py 作模板。
# ------------------------------------------------------------
wy_site/wy_site/local_settings.py
.env
.env.*
!*.env.example
!.env.example
*.pem
*.key
secrets.json


# ------------------------------------------------------------
# 6. 开发工具（PyCharm / VS Code）
#    .idea/ 里含你的编辑器设置和数据库连接信息（dataSources.xml），
#    没必要给别人，也避免路径冲突。
# ------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
out/
.~*


# ------------------------------------------------------------
# 7. 测试 / 类型检查缓存
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml


# ------------------------------------------------------------
# 8. 打包 / 分发
# ------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
wheels/
sdist/


# ------------------------------------------------------------
# 9. 操作系统 / Office 临时文件
#    ~$ 开头的是 Word 打开文档时生成的锁文件。
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
~$*


# ------------------------------------------------------------
# 10. 本地零散文件（按需自行调整）
#     这两个是我生成的报告和备份包，不属于项目源码。
#     想一起提交就注释掉下面两行。
# ------------------------------------------------------------
项目检查报告.md
wy_site_上课备份.zip
